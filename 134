--// 🌟 COMBAT: Csync (Desync) 통합 관리 시스템
--//======================================================================================--
local _csyncLocalCF, _csyncLocalLV, _csyncLocalAV = nil, nil, nil
local _csyncFakeCF, _csyncFakeLV = nil, nil
local _csyncConn, _noclipConn = nil, nil

local function StopCsync()
    RunService:UnbindFromRenderStep("Lynoria_Csync")
    if _csyncConn then _csyncConn:Disconnect(); _csyncConn = nil end
    _csyncFakeCF = nil; _csyncLocalCF = nil
end

local function StartCsync()
    if _csyncConn then return end
    _csyncConn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        _csyncLocalCF = h.CFrame
        _csyncLocalLV = h.AssemblyLinearVelocity
        _csyncLocalAV = h.AssemblyAngularVelocity

        if _csyncFakeCF then
            h.CFrame = _csyncFakeCF
            h.AssemblyLinearVelocity = _csyncFakeLV or Vector3.zero
            h.AssemblyAngularVelocity = Vector3.new(math.random(-10000, 10000), math.random(-10000, 10000), math.random(-10000, 10000))
        end
    end)

    RunService:BindToRenderStep("Lynoria_Csync", Enum.RenderPriority.First.Value, function()
        local cf = _csyncLocalCF
        if not cf then return end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        if Toggles.KnifeFarm_Enabled.Value or Toggles.AutoTp_Enabled.Value or Toggles.RageBot_Enabled.Value then return end
        
        h.CFrame = cf
        h.AssemblyLinearVelocity = _csyncLocalLV or Vector3.zero
        h.AssemblyAngularVelocity = _csyncLocalAV or Vector3.zero
    end)
end

local function UpdateCsyncState()
    if Toggles.KnifeFarm_Enabled.Value or Toggles.AutoTp_Enabled.Value or Toggles.RageBot_Enabled.Value then
        StartCsync()
    else
        StopCsync()
    end
end

local function EnableNoclip()
    if _noclipConn then return end
    _noclipConn = RunService.Stepped:Connect(function()
        local lc = LocalPlayer.Character
        if not lc then return end
        for _, p in lc:GetDescendants() do if p:IsA("BasePart") then p.CanCollide = false end end
    end)
end

local function DisableNoclip()
    if _noclipConn then _noclipConn:Disconnect(); _noclipConn = nil end
    local lc = LocalPlayer.Character
    if lc then for _, p in lc:GetDescendants() do if p:IsA("BasePart") then p.CanCollide = true end end end
end

