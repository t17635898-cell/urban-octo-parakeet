--// 팀 체크 및 킬 체크 함수
local function isSameTeam(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false end
    local playerTeamID = targetPlayer:GetAttribute("TeamID")
    local localTeamID = LocalPlayer:GetAttribute("TeamID")
    if playerTeamID and localTeamID then return playerTeamID == localTeamID end
    return false
end

local function PlayerIsDead(p)
    if not p then return true end
    local c = p.Character
    if not c then return true end
    local h = c:FindFirstChild("Humanoid")
    return not h or h.Health <= 0 or not c:FindFirstChild("HumanoidRootPart")
end

--// 공통 타겟 탐지 함수
local function GetClosestTarget()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local closestTarget, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or isSameTeam(player) or not player.Character then continue end
        if Toggles.KillCheck.Value and PlayerIsDead(player) then continue end
        local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
        local tHead = player.Character:FindFirstChild("Head")
        local tHum = player.Character:FindFirstChildWhichIsA("Humanoid")
        if tRoot and tHead and tHum and tHum.Health > 0 then
            local dist = (rootPart.Position - tRoot.Position).Magnitude
            if dist < closestDist then closestDist = dist; closestTarget = player end
        end
    end
    return closestTarget
end

